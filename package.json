{
  "name": "dsh-extra-workspaces",
  "version": "0.1.0",
  "description": "Per-session extra working directories for DSH: an option inside the session-settings page plus a runtime-context reminder that tells the model which extra directories this session may use.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "test": "node --test \"tests/**/*.spec.mjs\""
  },
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "README.md",
    "docs"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "dsh-session-settings"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4"
  }
}
